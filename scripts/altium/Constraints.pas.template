Procedure Run;
Var
    Board : IPCB_Board;
    Doc : IServerDocument;
    It : IPCB_BoardIterator;
    Rule : IPCB_Rule;
    WidthRule : IPCB_MaxMinWidthConstraint;
    ClearanceRule : IPCB_ClearanceConstraint;
    ViaRule : IPCB_RoutingViaStyleRule;
    LayersRule : IPCB_RoutingLayersRule;
    DiffRule : IPCB_DifferentialPairsRoutingRule;
    Report : TStringList;
    N, L : Integer;
Begin
    Report := TStringList.Create;
    Try
        Report.Add('[job]');
        Report.Add('request=@@REQUEST@@');
        Report.Add('board=@@BOARD@@');
        Report.Add('units=altium_internal_coordinates');
        Report.Add('layer_index_domain=legacy_signal_1_to_32_not_physical_stack');
        Doc := Client.OpenDocument('PCB', '@@BOARD@@');
        If Doc = Nil Then Exit;
        Client.ShowDocument(Doc);
        Board := PCBServer.GetCurrentPCBBoard;
        If Board = Nil Then Exit;
        If UpperCase(Board.FileName) <> UpperCase('@@BOARD@@') Then Exit;
        It := Board.BoardIterator_Create;
        Try
            It.AddFilter_ObjectSet(MkSet(eRuleObject));
            It.AddFilter_LayerSet(AllLayers);
            It.AddFilter_Method(eProcessAll);
            Rule := It.FirstPCBObject;
            N := 0;
            While Rule <> Nil Do
            Begin
                Report.Add('[rule.' + IntToStr(N) + ']');
                Report.Add('name=' + Rule.Name);
                Report.Add('kind=' + IntToStr(Rule.RuleKind));
                Report.Add('scope1=' + Rule.Scope1Expression);
                Report.Add('scope2=' + Rule.Scope2Expression);
                Report.Add('priority=' + IntToStr(Rule.Priority));
                Report.Add('drc_enabled=' + BoolToStr(Rule.DRCEnabled, True));
                Case Rule.RuleKind Of
                    0:
                    Begin
                        ClearanceRule := Rule;
                        Report.Add('gap=' + IntToStr(ClearanceRule.Gap));
                        Report.Add('numeric_profile=scalar_gap_not_clearance_matrix');
                    End;
                    2:
                    Begin
                        WidthRule := Rule;
                        Report.Add('impedance_driven=' + BoolToStr(WidthRule.ImpedanceDriven, True));
                        For L := 1 To 32 Do
                        Begin
                            Report.Add('min_width_' + IntToStr(L) + '=' + IntToStr(WidthRule.MinWidth[L]));
                            Report.Add('max_width_' + IntToStr(L) + '=' + IntToStr(WidthRule.MaxWidth[L]));
                            Report.Add('favored_width_' + IntToStr(L) + '=' + IntToStr(WidthRule.FavoredWidth[L]));
                        End;
                    End;
                    9:
                    Begin
                        LayersRule := Rule;
                        For L := 1 To 32 Do
                            Report.Add('routing_allowed_' + IntToStr(L) + '=' + BoolToStr(LayersRule.RoutingLayers[L], True));
                    End;
                    11:
                    Begin
                        ViaRule := Rule;
                        Report.Add('min_hole_width=' + IntToStr(ViaRule.MinHoleWidth));
                        Report.Add('max_hole_width=' + IntToStr(ViaRule.MaxHoleWidth));
                        Report.Add('preferred_hole_width=' + IntToStr(ViaRule.PreferedHoleWidth));
                        Report.Add('min_width=' + IntToStr(ViaRule.MinWidth));
                        Report.Add('max_width=' + IntToStr(ViaRule.MaxWidth));
                        Report.Add('preferred_width=' + IntToStr(ViaRule.PreferedWidth));
                        Report.Add('via_style=' + IntToStr(ViaRule.ViaStyle));
                    End;
                    51:
                    Begin
                        DiffRule := Rule;
                        Report.Add('max_uncoupled_length=' + IntToStr(DiffRule.MaxUncoupledLength));
                        For L := 1 To 32 Do
                        Begin
                            Report.Add('min_gap_' + IntToStr(L) + '=' + IntToStr(DiffRule.MinGap[L]));
                            Report.Add('max_gap_' + IntToStr(L) + '=' + IntToStr(DiffRule.MaxGap[L]));
                            Report.Add('preferred_gap_' + IntToStr(L) + '=' + IntToStr(DiffRule.PreferedGap[L]));
                        End;
                    End;
                Else
                    Report.Add('numeric_profile=not_captured');
                End;
                N := N + 1;
                Rule := It.NextPCBObject;
            End;
        Finally
            Board.BoardIterator_Destroy(It);
        End;
        Client.CloseDocument(Doc);
        Report.Add('[completion]');
        Report.Add('status=completed');
    Finally
        Report.SaveToFile('@@REPORT@@');
        Report.Free;
    End;
End;
